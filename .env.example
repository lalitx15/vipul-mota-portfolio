# ========================================================
# VIPUL GOVINDJI MOTA / JAVI GROUPS PORTFOLIO
# Environment Configuration Template (.env.example)
# ========================================================

# 1. Site Domain & Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 2. Supabase Infrastructure (Postgres, Auth, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# 3. Email Infrastructure (Resend)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM="Vipul Govindji Mota <connect@javigroups.com>"
OWNER_NOTIFICATION_EMAIL=connect@javigroups.com

# 4. Distributed Rate Limiting (Optional - Falls back to In-Memory sliding window)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 5. Firebase Configuration (Google Auth & Analytics)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-app.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id

